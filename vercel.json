{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/", "destination": "/index_template_jp.html" },
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/legacy", "destination": "/index_legacy.html" },
        { "source": "/template", "destination": "/index_template_jp.html" }
    ],
    "headers": [
        {
            "source": "/uploads/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/content/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, s-maxage=0, must-revalidate"
                }
            ]
        }
    ]
}