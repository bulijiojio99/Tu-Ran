{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/legacy", "destination": "/index_legacy.html" },
        { "source": "/template", "destination": "/index_template_jp.html" },
        { "source": "/template-b", "destination": "/index_template_jp_b.html" }
    ],
    "headers": [
        {
            "source": "/uploads/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/content/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=60"
                }
            ]
        }
    ]
}